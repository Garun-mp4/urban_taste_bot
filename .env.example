# Telegram
TELEGRAM_BOT_TOKEN=<YOUR_BOT_TOKEN>
ADMIN_CHAT_ID=<YOUR_CHAT_ID>
# Optional: comma-separated Telegram user IDs allowed to manage an admin group.
ADMIN_USER_IDS=

# OpenAI API (ChatGPT subscription is not used)
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium

# Optional Telegraph account token for republishing the menu with scripts/publish_menu.py
TELEGRAPH_ACCESS_TOKEN=
# Public HTTPS directory containing the committed menu images. Required only when publishing pages.
MENU_IMAGE_BASE_URL=https://raw.githubusercontent.com/Garun-mp4/urban_taste_bot/main/assets/menu

# Runtime safety
DROP_PENDING_UPDATES=false
RATE_LIMIT_SECONDS=1.0
NOTIFICATION_POLL_SECONDS=2.0
NOTIFICATION_MAX_ATTEMPTS=10

# Booking rules (adjust to the real restaurant capacity and operations)
RESERVATION_CAPACITY=50
RESERVATION_MAX_GUESTS=50
RESERVATION_DURATION_MINUTES=90
RESERVATION_SLOT_INTERVAL_MINUTES=30
RESERVATION_MIN_ADVANCE_MINUTES=30
RESERVATION_MAX_DAYS=30
PROCESSED_EVENT_RETENTION_DAYS=30

# PostgreSQL / Redis for Docker Compose
POSTGRES_DB=urban_taste
POSTGRES_USER=urban_taste
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://urban_taste:change_me@db:5432/urban_taste
REDIS_URL=redis://redis:6379/0

# Runtime
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
AI_HISTORY_LIMIT=12
AI_HISTORY_CHAR_LIMIT=24000
AI_TIMEOUT_SECONDS=45
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
